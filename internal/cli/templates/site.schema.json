{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "indoc site document",
  "type": "object",
  "required": ["project_name", "overview"],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "appearance": {
      "$ref": "#/$defs/appearance"
    },
    "overview": {
      "$ref": "#/$defs/overview"
    },
    "guides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "reference": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceSection"
      }
    }
  },
  "$defs": {
    "appearance": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "description": "A local image path relative to this JSON file, or an http(s) URL."
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "required": ["markdown"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guide": {
      "type": "object",
      "required": ["title", "markdown"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "referenceSection": {
      "type": "object",
      "required": ["kind", "entries"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": ["routes", "config"]
        },
        "intro": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/referenceEntry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "routes"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "required": ["name", "detail"]
                }
              }
            }
          }
        }
      ]
    },
    "referenceEntry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}
