#!/bin/sh
# Runs the indoc binary for this plugin version, downloading it on first use.
#
# The binary comes from the GitHub release matching VERSION, is verified
# against the release's checksums.txt, and is cached in the plugin's data
# directory. Nothing is written to stdout: it carries the MCP protocol.
# INDOC_BIN=/path/to/indoc uses a local build instead.
set -eu

VERSION="0.7.0" # must equal the plugin version; the release workflow checks it
RELEASES="${INDOC_RELEASES_URL:-https://github.com/byabasaija/indoc/releases/download}"

if [ -n "${INDOC_BIN:-}" ]; then
  exec "$INDOC_BIN" "$@"
fi

data="${CLAUDE_PLUGIN_DATA:-${PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/indoc}}"
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) echo "indoc: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac
exe=indoc
case "$os" in
  darwin | linux) archive="indoc_${os}_${arch}.tar.gz" ;;
  mingw* | msys* | cygwin*) os=windows; exe=indoc.exe; archive="indoc_windows_${arch}.zip" ;;
  *) echo "indoc: unsupported operating system $os" >&2; exit 1 ;;
esac
bin="$data/indoc-$VERSION-$exe"

if [ ! -x "$bin" ]; then
  tmp=$(mktemp -d)
  fetch() {
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$1" -o "$2"
    else
      wget -q "$1" -O "$2"
    fi
  }
  sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
      sha256sum "$1" | cut -d' ' -f1
    else
      shasum -a 256 "$1" | cut -d' ' -f1
    fi
  }
  echo "indoc: downloading v$VERSION ($os/$arch)" >&2
  if ! fetch "$RELEASES/v$VERSION/$archive" "$tmp/$archive" || ! fetch "$RELEASES/v$VERSION/checksums.txt" "$tmp/checksums.txt"; then
    rm -rf "$tmp"
    echo "indoc: could not download v$VERSION from $RELEASES" >&2
    exit 1
  fi
  expected=$(grep " $archive\$" "$tmp/checksums.txt" | cut -d' ' -f1)
  actual=$(sha256 "$tmp/$archive")
  if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
    rm -rf "$tmp"
    echo "indoc: checksum mismatch for $archive; refusing to run it" >&2
    exit 1
  fi
  case "$archive" in
    *.zip) (cd "$tmp" && unzip -q "$archive" "$exe") ;;
    *) tar -xzf "$tmp/$archive" -C "$tmp" "$exe" ;;
  esac
  mkdir -p "$data"
  mv "$tmp/$exe" "$bin.tmp"
  chmod +x "$bin.tmp"
  mv -f "$bin.tmp" "$bin"
  rm -rf "$tmp"
fi

exec "$bin" "$@"
